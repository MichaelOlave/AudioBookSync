# ============================================================================
# Bandit Configuration - Python Security Issue Scanner
# ============================================================================
# Documentation: https://bandit.readthedocs.io/

[bandit]
# Tests to run
tests = [B101, B102, B103, B104, B105, B106, B107, B108, B201, B301, B302, B303, B304, B305, B306, B307, B308, B309, B310, B311, B312, B313, B314, B315, B316, B317, B318, B319, B320, B321, B322, B323, B324, B325, B601, B602, B603, B604, B605, B606, B607, B608, B609, B610, B611, B612, B613, B614, B615, B616, B617, B618, B619, B620, B621, B622, B623, B624, B625, B626, B627, B628, B629, B630, B631, B632, B633, B634, B635]

# Skipped tests (tests to exclude from the run)
skips = []

# Excluded paths
exclude_dirs = [
    "/test",
    "/tests",
    "/.venv",
    "/venv",
    "/migrations",
]

# Specific files to exclude
exclude_files = [
    "**/conftest.py",
    "**/test_*.py",
]

# Report format: json, csv, txt, xml, screen
output_format = screen

# Aggregate output by level
aggregate = true

# Sort output by filename
sort_by = filename

# Print only issues of high or medium severity
severity_level = medium
