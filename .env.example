################################################################################
# AudioBookSync Environment Configuration
#
# Copy this file to .env and update the values for your environment
################################################################################

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL database URL (format: postgresql://user:password@host:port/database)
DATABASE_URL=postgresql://postgres@localhost:5432/audiobooksync

# ============================================================================
# AUDIBLE AUTHENTICATION
# ============================================================================
# Path to Audible authentication JSON file (from audible-cli)
AUTH_FILE=auth.json
# Activation bytes for DRM decryption (from Audible account)
ACTIVATION_BYTES=bytes_go_here

# ============================================================================
# DIRECTORIES
# ============================================================================
# Directory for downloaded audiobooks (encrypted)
DOWNLOAD_DIR=audiobooks/downloaded
# Directory for decrypted audiobooks
DECRYPTED_DIR=audiobooks/decrypted
# Directory for application logs
LOG_DIR=logs

# ============================================================================
# AUDIBLE API SETTINGS
# ============================================================================
# Number of results to fetch from Audible API per request
AUDIBLE_NUM_RESULTS=2
# Response groups to request from Audible API
# Comprehensive groups for rich metadata: contributors, media, rating, categories, etc.
AUDIBLE_RESPONSE_GROUPS=product_desc, product_attrs, contributors, media, series, rating, reviews, categories, category_ladders, price, cover_art_url, publisher, publication_date, origin_asin, is_returnable, is_removable, is_archived, is_playable, pdf_url, sku, badge_types, review_attrs, relationships, percent_complete, last_position_heard, is_finished, listening_status, claim_code_url
# Sort order for Audible library (-PurchaseDate = newest first)
AUDIBLE_SORT_BY=-PurchaseDate

# ============================================================================
# FASTAPI CONFIGURATION
# ============================================================================
# API server host and port
API_HOST=0.0.0.0
API_PORT=8000
# Number of worker processes (for production use with gunicorn)
API_WORKERS=4
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Secret key for JWT signing - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
# JWT algorithm for token signing
JWT_ALGORITHM=HS256
# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins for CORS
# Examples: http://localhost:3000, http://localhost:8080, https://example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ============================================================================
# FILE SERVING CONFIGURATION
# ============================================================================
# Maximum file size for uploads/streaming in bytes (default: 5GB)
MAX_FILE_SIZE=5368709120
# Chunk size for file streaming in bytes (default: 1MB)
CHUNK_SIZE=1048576

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# Maximum requests per minute for API endpoints
RATE_LIMIT_PER_MINUTE=60
# Rate limit for login endpoint (attempts per minute)
RATE_LIMIT_LOGIN_PER_MINUTE=5
