################################################################################
# AudioBookSync Environment Configuration
#
# Copy this file to .env and update the values for your environment
################################################################################

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL database URL (format: postgresql://user:password@host:port/database)
DATABASE_URL=postgresql://postgres@localhost:5432/audiobooksync

# ============================================================================
# AUDIBLE AUTHENTICATION
# ============================================================================
# Path to Audible authentication JSON file (from audible-cli)
AUTH_FILE=auth.json
# Activation bytes for DRM decryption (from Audible account)
ACTIVATION_BYTES=bytes_go_here

# ============================================================================
# AUDIBLE API SETTINGS
# ============================================================================
# Number of results to fetch from Audible API per request
AUDIBLE_NUM_RESULTS=2
# Response groups to request from Audible API
# Comprehensive groups for rich metadata: contributors, media, rating, categories, etc.
AUDIBLE_RESPONSE_GROUPS=product_desc, product_attrs, contributors, media, series, rating, reviews, categories, category_ladders, price, cover_art_url, publisher, publication_date, origin_asin, is_returnable, is_removable, is_archived, is_playable, pdf_url, sku, badge_types, review_attrs, relationships, percent_complete, last_position_heard, is_finished, listening_status, claim_code_url
# Sort order for Audible library (-PurchaseDate = newest first)
AUDIBLE_SORT_BY=-PurchaseDate

# ============================================================================
# FASTAPI CONFIGURATION
# ============================================================================
# API server host and port
API_HOST=0.0.0.0
API_PORT=8000
# Number of worker processes (for production use with gunicorn)
API_WORKERS=4
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# LOG RETENTION CONFIGURATION
# ============================================================================
# Retention policy for application logs stored in database (in days)
# DEBUG logs are rotated more frequently, ERROR logs retained longer
LOG_RETENTION_DAYS_DEBUG=7
LOG_RETENTION_DAYS_INFO=30
LOG_RETENTION_DAYS_WARNING=90
LOG_RETENTION_DAYS_ERROR=180

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Secret key for JWT signing - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
# JWT algorithm for token signing
JWT_ALGORITHM=HS256
# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins for CORS
# Examples: http://localhost:3000, http://localhost:8080, https://example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ============================================================================
# FILE SERVING CONFIGURATION
# ============================================================================
# Maximum file size for uploads/streaming in bytes (default: 5GB)
MAX_FILE_SIZE=5368709120
# Chunk size for file streaming in bytes (default: 1MB)
CHUNK_SIZE=1048576

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# Maximum requests per minute for API endpoints
RATE_LIMIT_PER_MINUTE=60
# Rate limit for login endpoint (attempts per minute)
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ============================================================================
# MINIO OBJECT STORAGE CONFIGURATION
# ============================================================================
# MinIO Server Endpoint
# Format: host:port (without http/https)
# Examples:
#   - Local development: localhost:9000
#   - Docker compose: minio:9000
#   - Production: minio.example.com:9000
MINIO_ENDPOINT=localhost:9000

# MinIO Access Key (username)
# Should be a strong, unique value in production
# Default development value: minioadmin
MINIO_ACCESS_KEY=minioadmin

# MinIO Secret Key (password)
# Should be a strong, unique value in production
# Default development value: minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO Secure Connection (HTTPS)
# Set to 'true' for production HTTPS connections
# Set to 'false' for development HTTP connections
# Default: false
MINIO_SECURE=false

# ============================================================================
# MINIO FEATURE FLAG AND MIGRATION SETTINGS
# ============================================================================
# Enable MinIO storage for new downloads and decryptions
# When false: system uses local filesystem only (backward compatible)
# When true: new downloads/decryptions automatically upload to MinIO
# Recommended workflow:
#   1. Deploy with USE_MINIO_STORAGE=false
#   2. Run migration script to migrate existing files
#   3. Verify migration success
#   4. Set USE_MINIO_STORAGE=true for new operations
# Default: false
USE_MINIO_STORAGE=false

# Failure rate threshold for automatic rollback during migration
# If failure rate (failed / total) >= threshold, migration automatically rolls back
# Value range: 0.0 to 1.0
# Default: 0.10 (10%)
# Example: 0.05 for 5% threshold, 0.20 for 20% threshold
MIGRATION_FAILURE_THRESHOLD=0.10

# Lock timeout for migration processing in hours
# Prevents stale locks from blocking migrations in multi-instance deployments
# If a migration is locked for longer than this duration, lock is released
# Default: 2 hours
# Typical range: 1-4 hours
MIGRATION_LOCK_TIMEOUT_HOURS=2

# Batch size for migration processing
# Number of files to process in each batch during migration
# Larger batches are faster but consume more memory
# Smaller batches allow better progress tracking and easier recovery
# Default: 10
# Typical range: 5-50 depending on file sizes and available memory
MIGRATION_BATCH_SIZE=10

# Cleanup schedule for orphaned MinIO files
# Cron schedule expression (standard cron format: minute hour day month dayofweek)
# Examples:
#   - "0 2 * * *" = daily at 2:00 AM
#   - "0 */6 * * *" = every 6 hours
#   - "0 0 * * 0" = weekly on Sunday at midnight
# Default: "0 2 * * *" (daily at 2:00 AM)
CLEANUP_SCHEDULE=0 2 * * *

# ============================================================================
# MINIO DEPLOYMENT NOTES
# ============================================================================
# Before using MinIO storage, ensure:
#
# 1. MinIO Service is Running
#    - MinIO must be deployed and accessible at MINIO_ENDPOINT
#    - Test connectivity: curl -I http://<MINIO_ENDPOINT>/minio/health/live
#
# 2. Credentials are Secure
#    - Use strong, unique credentials for production
#    - Never commit actual credentials to version control
#    - Use secrets management (environment variables, vaults)
#
# 3. Network Connectivity
#    - API server must be able to reach MinIO endpoint
#    - Test from API server: nc -zv <MINIO_ENDPOINT> <port>
#
# 4. Storage Space
#    - Ensure sufficient disk space on MinIO server
#    - Consider 1.5x total file size for safe migration (temporary duplication)
#    - Monitor disk usage during and after migration
#
# 5. Backup Strategy
#    - MinIO files can be lost if storage fails
#    - Consider MinIO replication for production
#    - Maintain regular backups of MinIO data
#
# 6. Monitoring and Alerts
#    - Monitor /api/v1/health endpoint for MinIO status
#    - Set up alerts for MinIO connectivity loss
#    - Watch migration_status table for failed migrations
#    - Review error_log table for MinIO-related errors
#
# Migration Workflow:
# 1. Deploy MinIO service
# 2. Set MINIO_* variables
# 3. Deploy application code
# 4. Run migration script: python scripts/migrate_to_minio.py --dry-run
# 5. Review migration statistics
# 6. Run real migration: python scripts/migrate_to_minio.py
# 7. Monitor migration progress
# 8. Verify migration success with database queries
# 9. Set USE_MINIO_STORAGE=true
# 10. Monitor system for 24 hours
# 11. If issues: rollback (set USE_MINIO_STORAGE=false and reload)
#
# For detailed deployment instructions, see:
# agent-os/specs/2026-01-01-migrate-to-minio-object-storage/deployment-runbook.md
