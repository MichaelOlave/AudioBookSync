# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# that shouldn't be part of version control
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
*.swp
*.swo
*~
.vscode/

# Terraform lock files (optional, but recommended to commit)
# .terraform.lock.hcl
